# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL connection string used by Prisma locally and in production.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret Better Auth: generate it with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the Express application; Better Auth uses it for cookies and OAuth callbacks.
BETTER_AUTH_URL="http://localhost:3001"
# Google OAuth is optional. Configure both values to enable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mails transactionnels de réinitialisation de mot de passe (serveur uniquement).
RESEND_API_KEY=""
# Adresse ou expéditeur dont le domaine est vérifié dans Resend.
RESEND_FROM_EMAIL="LocaManager <locatix@discom-group.com>"
# Set to true only when the backend Google OAuth credentials are configured.
VITE_GOOGLE_AUTH_ENABLED="false"

# Email du compte SuperAdmin racine.
SUPERADMIN_EMAIL="direction@discom.cm"
# Clé secrète temporaire requise pour recréer le SuperAdmin après un reset complet.
SUPERADMIN_BOOTSTRAP_KEY="replace-with-a-long-random-bootstrap-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public frontend URL allowed by the Express backend (Render).
FRONTEND_URL="http://localhost:3000"

# Express API port for local development.
PORT="3001"

# Backend URL used by the Vite frontend (Vercel).
VITE_API_URL="http://localhost:3000"

# Development-only auth bypass. Keep false or unset in production.
ENABLE_DEV_AUTH="false"
VITE_ENABLE_DEV_AUTH="false"
