generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                @id @default(autoincrement())
  uid                   String             @unique
  email                 String             @unique
  nom                   String
  phone                 String?
  role                  String             @default("PROPRIETAIRE")
  nomEntreprise         String?            @map("nom_entreprise")
  numeroRcs             String?            @map("numero_rcs")
  numeroContribuable    String?            @map("numero_contribuable")
  pays                  String?            @default("Cameroun")
  ville                 String?
  adresse               String?
  avatarUrl             String?            @map("avatar_url")
  mustChangePassword    Boolean?           @default(false) @map("must_change_password")
  isVerified            Boolean?           @default(true) @map("is_verified")
  createdAt             DateTime?          @default(now()) @map("created_at")
  updatedAt             DateTime?          @default(now()) @updatedAt @map("updated_at")
  pendingEmail          String?            @map("pending_email")
  pendingEmailExpiresAt DateTime?          @map("pending_email_expires_at")
  pendingEmailToken     String?            @unique @map("pending_email_token")
  activitesGerant       ActiviteGerant[]
  biens                 Bien[]
  gerantsAdjoints       GerantAdjoint[]
  locataires            Locataire[]
  securityAuditLogs     SecurityAuditLog[]
  subscriptions         Subscription[]

  @@map("users")
}

model SubscriptionPlan {
  id            String         @id
  nom           String
  maxBiens      Int?           @default(5) @map("max_biens")
  maxLogements  Int?           @default(20) @map("max_logements")
  prixMensuel   Int            @default(15000) @map("prix_mensuel")
  prixAnnuel    Int            @default(150000) @map("prix_annuel")
  description   String?
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  planId    String           @map("plan_id")
  status    String           @default("ACTIVE")
  startDate DateTime?        @default(now()) @map("start_date")
  endDate   DateTime         @map("end_date")
  createdAt DateTime?        @default(now()) @map("created_at")
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Bien {
  id             Int        @id @default(autoincrement())
  proprietaireId Int        @map("proprietaire_id")
  nom            String
  type           String     @default("immeuble")
  adresse        String
  ville          String
  pays           String?    @default("Cameroun")
  nombreEtages   Int?       @default(1) @map("nombre_etages")
  aLogementsRdc  Boolean?   @default(true) @map("a_logements_rdc")
  aSousSol       Boolean?   @default(false) @map("a_sous_sol")
  nombreSousSols Int?       @default(0) @map("nombre_sous_sols")
  description    String?
  photo          String?
  createdAt      DateTime?  @default(now()) @map("created_at")
  proprietaire   User       @relation(fields: [proprietaireId], references: [id])
  logements      Logement[]

  @@map("biens")
}

model Logement {
  id              Int       @id @default(autoincrement())
  bienId          Int       @map("bien_id")
  numero          String
  nom             String
  type            String    @default("appartement")
  nombrePieces    Int?      @default(2) @map("nombre_pieces")
  etage           Int?      @default(0)
  superficie      Int?      @default(50)
  loyerReference  Int       @default(100000) @map("loyer_reference")
  chargesIncluses Int       @default(10000) @map("charges_incluses")
  statut          String?   @default("libre")
  description     String?
  photo           String?
  createdAt       DateTime? @default(now()) @map("created_at")
  baux            Bail[]
  bien            Bien      @relation(fields: [bienId], references: [id])

  @@map("logements")
}

model Locataire {
  id             Int        @id @default(autoincrement())
  proprietaireId Int        @map("proprietaire_id")
  nom            String
  telephone      String
  email          String?
  cni            String?
  profession     String?
  contactGarant  String?    @map("contact_garant")
  createdAt      DateTime?  @default(now()) @map("created_at")
  authUid        String?    @unique @map("auth_uid")
  baux           Bail[]
  proprietaire   User       @relation(fields: [proprietaireId], references: [id])
  paiements      Paiement[]

  @@map("locataires")
}

model SecurityAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("security_audit_logs")
}

model Bail {
  id                Int        @id @default(autoincrement())
  locataireId       Int        @map("locataire_id")
  logementId        Int        @map("logement_id")
  loyerMensuel      Int        @map("loyer_mensuel")
  chargesMensuelles Int?       @default(0) @map("charges_mensuelles")
  depotGarantie     Int?       @default(0) @map("depot_garantie")
  fraisDossier      Int?       @default(0) @map("frais_dossier")
  dateDebut         String     @map("date_debut")
  dateFin           String?    @map("date_fin")
  statut            String?    @default("actif")
  createdAt         DateTime?  @default(now()) @map("created_at")
  locataire         Locataire  @relation(fields: [locataireId], references: [id])
  logement          Logement   @relation(fields: [logementId], references: [id])
  paiements         Paiement[]

  @@map("baux")
}

model Paiement {
  id           Int       @id @default(autoincrement())
  bailId       Int       @map("bail_id")
  locataireId  Int       @map("locataire_id")
  montant      Int
  moisConcerne String    @map("mois_concerne")
  modePaiement String?   @default("especes") @map("mode_paiement")
  statut       String?   @default("valide")
  reference    String?
  datePaiement String    @map("date_paiement")
  createdAt    DateTime? @default(now()) @map("created_at")
  bail         Bail      @relation(fields: [bailId], references: [id])
  locataire    Locataire @relation(fields: [locataireId], references: [id])

  @@map("paiements")
}

model GerantAdjoint {
  id             Int              @id @default(autoincrement())
  uid            String           @unique
  email          String
  name           String
  phonenumber    String
  password       String?
  statutCompte   String?          @default("actif") @map("statut_compte")
  permissions    Json?
  proprietaireId Int              @map("proprietaire_id")
  createdAt      DateTime?        @default(now()) @map("created_at")
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at")
  activites      ActiviteGerant[]
  proprietaire   User             @relation(fields: [proprietaireId], references: [id])

  @@map("gerants_adjoints")
}

model ActiviteGerant {
  id              Int            @id @default(autoincrement())
  gerantId        Int?           @map("gerant_id")
  gerantUid       String?        @map("gerant_uid")
  gerantNom       String         @map("gerant_nom")
  bailleurId      Int            @map("bailleur_id")
  actionType      String         @map("action_type")
  titre           String
  description     String
  montantFcfa     Int?           @map("montant_fcfa")
  quittanceNumero String?        @map("quittance_numero")
  reference       String?
  locataireNom    String?        @map("locataire_nom")
  logementNom     String?        @map("logement_nom")
  date            String
  heure           String
  statut          String?        @default("succes")
  createdAt       DateTime?      @default(now()) @map("created_at")
  bailleur        User           @relation(fields: [bailleurId], references: [id])
  gerant          GerantAdjoint? @relation(fields: [gerantId], references: [id])

  @@map("activites_gerant")
}

model AuthUser {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]

  @@map("auth_users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("verification")
}
